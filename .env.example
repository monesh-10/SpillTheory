# SpillTheory environment configuration example.
# Copy this file to .env and fill in the values.
# .env is gitignored and must NOT be committed.

# ─── EO Model ────────────────────────────────────────────────────────────────
# Path to the SeaRel-SR-UNet V3 checkpoint (best_v3_miou.pt).
# If not set, the application defaults to: EO_Context/best_v3_miou.pt
# relative to the repository root.
EO_MODEL_PATH=EO_Context/best_v3_miou.pt
